# Python environment (recreate with: python -m venv .venv && .venv\Scripts\pip install -r requirements.txt)
.venv/
__pycache__/
*.pyc

# Build output — publish the .exe as a GitHub Release instead
build/
dist/
*.spec

# Download caches and scratch data (re-created by the tools/ scripts)
tools/cache/
tools/apc/

# Photo sorting: keep the scripts, not the GPU venv, downloads, logs or bulky results
# (full_results.jsonl is kept in the release backup zip instead)
experiments/photo-sort/.venv/
experiments/photo-sort/images/
experiments/photo-sort/cache/
experiments/photo-sort/*.log
experiments/photo-sort/results*.json
experiments/photo-sort/full_results.jsonl
experiments/photo-sort/review.html

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
desktop.ini

# Identify model: training photos, embeddings and exported models are rebuilt by
# experiments/photo-sort/identify/ (see README). The model ships inside the .exe;
# model/*.onnx (346 MB) is over GitHub's file size limit, so it is kept in the backup zip.
experiments/photo-sort/images_train/
experiments/photo-sort/identify/emb/
experiments/photo-sort/identify/model/
experiments/photo-sort/identify/grid.jsonl
experiments/photo-sort/identify/coords.json
experiments/photo-sort/identify/eval_*.npz
model/*.onnx
experiments/photo-sort/images_extra/
experiments/photo-sort/identify/extra.jsonl
experiments/photo-sort/identify/extras_*.json

# Logs
tools/*.log
